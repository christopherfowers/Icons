{
  "name": "glyph",
  "displayName": "Glyph Icons",
  "packageName": "glyph_icons",
  "packageVersion": "0.1.0",
  "packageDescription": "Glyph Icons — a grouped, self-hosted icon set for Flutter.",
  "classPrefix": "Glyph",
  "fontFamilyPrefix": "Glyph",
  "cssPrefix": "gi",
  "repository": "https://github.com/christopherfowers/Icons",
  "styles": {
    "line": {
      "viewBox": 24,
      "padding": 2,
      "strokeWidth": 1.5,
      "linecap": "butt",
      "linejoin": "miter",
      "kind": "line"
    },
    "solid": {
      "viewBox": 24,
      "padding": 1,
      "kind": "solid"
    },
    "round": {
      "kind": "line",
      "viewBox": 24,
      "padding": 2,
      "strokeWidth": 1.25,
      "linecap": "round",
      "linejoin": "round"
    }
  },
  "variants": {
    "outline": {
      "theme": "core",
      "weight": "outline",
      "style": "line",
      "description": "Neutral stroked centerlines. The library default."
    },
    "filled": {
      "theme": "core",
      "weight": "filled",
      "style": "solid",
      "description": "Neutral solid silhouettes."
    },
    "forge-outline": {
      "theme": "forge",
      "weight": "outline",
      "style": "line",
      "description": "Tsaraforge house style: strokes chipped and broken, as on worn stencilled plate."
    },
    "forge-filled": {
      "theme": "forge",
      "weight": "filled",
      "style": "solid",
      "description": "Tsaraforge house style: silhouettes fractured by crack slivers, matching the mark."
    },
    "merry-outline": {
      "theme": "merry",
      "weight": "outline",
      "style": "round",
      "description": "Warm rounded strokes for the Christmas Magic child app."
    },
    "merry-filled": {
      "theme": "merry",
      "weight": "filled",
      "style": "solid",
      "description": "Warm rounded silhouettes for the Christmas Magic child app."
    }
  },
  "defaultTheme": "core",
  "defaultWeight": "outline",
  "font": {
    "unitsPerEm": 1000,
    "descent": 0
  },
  "codepoints": {
    "start": "e000",
    "end": "f8ff"
  }
}
