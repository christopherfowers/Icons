{
  "name": "glyph",
  "displayName": "Glyph Icons",
  "packageName": "glyph_icons",
  "packageVersion": "0.1.0",
  "packageDescription": "Glyph Icons \u2014 a grouped, self-hosted icon set for Flutter.",
  "classPrefix": "Glyph",
  "fontFamilyPrefix": "Glyph",
  "cssPrefix": "gi",
  "repository": "https://github.com/christopherfowers/Icons",
  "styles": {
    "line": {
      "viewBox": 24,
      "padding": 2,
      "strokeWidth": 2,
      "linecap": "round",
      "linejoin": "round"
    },
    "solid": {
      "viewBox": 24,
      "padding": 1
    }
  },
  "variants": {
    "outline": {
      "style": "line",
      "familySuffix": "",
      "classSuffix": "",
      "description": "Stroked centerlines, converted to filled contours for the font."
    },
    "filled": {
      "style": "solid",
      "familySuffix": "Filled",
      "classSuffix": "Filled",
      "description": "Solid silhouettes with interior cuts."
    }
  },
  "defaultVariant": "outline",
  "font": {
    "unitsPerEm": 1000,
    "descent": 0
  },
  "codepoints": {
    "start": "e000",
    "end": "f8ff"
  }
}
