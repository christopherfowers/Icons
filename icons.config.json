{
  "name": "glyph",
  "displayName": "Glyph Icons",
  "packageName": "glyph_icons",
  "packageVersion": "0.1.0",
  "packageDescription": "Glyph Icons \u2014 a grouped, self-hosted icon set for Flutter.",
  "classPrefix": "Glyph",
  "fontFamilyPrefix": "Glyph",
  "cssPrefix": "gi",
  "repository": "https://github.com/christopherfowers/Icons",
  "styles": {
    "line": {
      "viewBox": 24,
      "padding": 2,
      "strokeWidth": 2,
      "linecap": "round",
      "linejoin": "round"
    },
    "solid": {
      "viewBox": 24,
      "padding": 1
    }
  },
  "variants": {
    "outline": {
      "theme": "core",
      "weight": "outline",
      "style": "line",
      "description": "Neutral stroked centerlines. The library default."
    },
    "filled": {
      "theme": "core",
      "weight": "filled",
      "style": "solid",
      "description": "Neutral solid silhouettes."
    },
    "eve-outline": {
      "theme": "eve",
      "weight": "outline",
      "style": "line",
      "description": "Space-sim themed strokes. Not drawn yet."
    },
    "eve-filled": {
      "theme": "eve",
      "weight": "filled",
      "style": "solid",
      "description": "Space-sim themed silhouettes. Not drawn yet."
    }
  },
  "defaultTheme": "core",
  "defaultWeight": "outline",
  "font": {
    "unitsPerEm": 1000,
    "descent": 0
  },
  "codepoints": {
    "start": "e000",
    "end": "f8ff"
  }
}
